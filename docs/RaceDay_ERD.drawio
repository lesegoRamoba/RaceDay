        <mxCell id="note0" parent="1" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=14;fontColor=#16324f;fontStyle=1;fillColor=#e2e8f0;" value="KEYS, DEFAULTS AND DATABASE CONSTRAINTS" vertex="1">
          <mxGeometry height="27" width="1600" x="40" y="935" as="geometry" />
        </mxCell>
        <mxCell id="note1" parent="1" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=14;fontColor=#16324f;" value="All primary keys: IDENTITY(1,1). All foreign keys: ON DELETE NO ACTION." vertex="1">
          <mxGeometry height="27" width="1600" x="40" y="962" as="geometry" />
        </mxCell>
        <mxCell id="note2" parent="1" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=14;fontColor=#16324f;" value="Roles.RoleName: Organiser or Participant. Events.EventType: Run, Walk or Cycle. Events.DistanceKm &gt; 0." vertex="1">
          <mxGeometry height="27" width="1600" x="40" y="989" as="geometry" />
        </mxCell>
        <mxCell id="note3" parent="1" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=14;fontColor=#16324f;" value="Categories: UNIQUE(EventID, CategoryName) and UNIQUE(EventID, CategoryID). CategoryType: Age or Distance." vertex="1">
          <mxGeometry height="27" width="1600" x="40" y="1016" as="geometry" />
        </mxCell>
        <mxCell id="note4" parent="1" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=14;fontColor=#16324f;" value="Age categories: at least one age bound; nonnegative bounds; MinAge &lt;= MaxAge when both exist; DistanceKm is NULL." vertex="1">
          <mxGeometry height="27" width="1600" x="40" y="1043" as="geometry" />
        </mxCell>
        <mxCell id="note5" parent="1" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=14;fontColor=#16324f;" value="Distance categories: DistanceKm &gt; 0; MinAge and MaxAge are NULL." vertex="1">
          <mxGeometry height="27" width="1600" x="40" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="note6" parent="1" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=14;fontColor=#16324f;" value="Enrolments: UNIQUE(ParticipantID, EventID). Status: Pending, Confirmed or Cancelled; DEFAULT Confirmed." vertex="1">
          <mxGeometry height="27" width="1600" x="40" y="1097" as="geometry" />
        </mxCell>
        <mxCell id="note7" parent="1" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=14;fontColor=#16324f;" value="* Composite FK: Enrolments(EventID, CategoryID) references Categories(EventID, CategoryID)." vertex="1">
          <mxGeometry height="27" width="1600" x="40" y="1124" as="geometry" />
        </mxCell>
        <mxCell id="note8" parent="1" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=14;fontColor=#16324f;" value="Enrolments.EventID also references Events.EventID; ParticipantID references Users.UserID." vertex="1">
          <mxGeometry height="27" width="1600" x="40" y="1151" as="geometry" />
        </mxCell>
        <mxCell id="note9" parent="1" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=14;fontColor=#16324f;" value="Events.OrganiserID references Users.UserID. Results.EnrolmentID is UNIQUE: each entry has zero or one result." vertex="1">
          <mxGeometry height="27" width="1600" x="40" y="1178" as="geometry" />
        </mxCell>
        <mxCell id="note10" parent="1" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=14;fontColor=#16324f;" value="Results: FinishTimeSeconds &gt;= 0; FinishingPosition &gt; 0; IsPublished DEFAULT 0." vertex="1">
          <mxGeometry height="27" width="1600" x="40" y="1205" as="geometry" />
        </mxCell>
        <mxCell id="note11" parent="1" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=14;fontColor=#16324f;" value="CreatedAt, EnrolledAt and RecordedAt: DEFAULT SYSUTCDATETIME(). Users and Events have a many-to-many link through Enrolments." vertex="1">
          <mxGeometry height="27" width="1600" x="120" y="1232" as="geometry" />
        </mxCell>
        <mxCell id="note12" parent="1" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=14;fontColor=#16324f;" value="API rules: organiser ownership; participant-only entries; matching age eligibility; hashed passwords; no future birth dates." vertex="1">
          <mxGeometry height="27" width="1600" x="40" y="1259" as="geometry" />
        </mxCell>
        <mxCell id="note13" parent="1" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=14;fontColor=#16324f;" value="Results can be recorded/published only after the event. Show participants published results only; count published finishers for totals." vertex="1">
          <mxGeometry height="27" width="1600" x="40" y="1286" as="geometry" />
        </mxCell>
        <mxCell id="note14" parent="1" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=14;fontColor=#16324f;" value="Image fields store Azure Blob URLs. Session authentication is server-side. Review the design before matching it in the SQL script." vertex="1">
